# Aria — Phase 0 configuration
# Copy this file to `.env` and fill in your key:  cp .env.example .env

# --- Required ------------------------------------------------------------
# xAI API key for the Grok Voice Agent API. Get one at https://console.x.ai
XAI_API_KEY=

# --- The one task ---------------------------------------------------------
# The "dashboard" Aria opens and reads when you say
# "open my dashboard and read me the top of the page".
ARIA_DASHBOARD_URL=https://news.ycombinator.com

# --- Voice / model (sensible defaults; override if you like) --------------
# Voice name offered by Grok (e.g. eve). See xAI docs for the current list.
ARIA_VOICE=eve
# grok-voice-latest always points at the newest Grok voice model.
ARIA_MODEL=grok-voice-latest

# How Aria reads the page aloud:
#   browser -> read the visible text from the real browser tab via AppleScript
#              (most faithful; needs "Allow JavaScript from Apple Events" enabled)
#   fetch   -> fetch the URL and extract readable text (no extra permission)
# Defaults to browser, automatically falling back to fetch if scripting is blocked.
ARIA_READ_METHOD=browser

# Max characters of page text to read aloud (keeps "the top of the page" short).
ARIA_READ_MAX_CHARS=1200
